# Contrail Manager config

# Do two-way coupling?
Two-way coupling: true

# Plume model. Options are:
# 1 - CoCiP
Plume model: 1

# Is this a restart run?
# The Contrail Manager will attempt to initialise from a corresponding output file if so
Restart: false

# Output interval
Output interval (min): 180

# Maximum length with which a contrail segment can be initialised
Max initial segment length (m): 2000

# Age at which a contrail segment, if it still exists, will be dumped into the NWP's native grid
Max contrail age (h): 6

# Maximum ratio of water vapour mass in contrail plume to water vapour mass in the grid cell it is
# inside; above this, the contrail is dumped into the NWP's native grid
Max accumulated vapour ratio (): 1e-2

# Paths to flight dataset files separated by commas within square brackets
# Read all datasets fulfilling a prefix by writing PREFIX: followed by the prefix
# Add only NONE or leave list empty for idle Contrail Manager
Flight dataset paths: [

]